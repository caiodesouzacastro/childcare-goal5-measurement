. * --- parse datas str (DD/MM/YYYY) ---
. foreach d in dt_criacao dt_ini_func dt_ini_conv dt_autoriza {
  2.     gen `d'_d = date(`d', "DMY")
  3.     format `d'_d %td
  4. }
(970 missing values generated)
(2,654 missing values generated)
(3,183 missing values generated)
(1,705 missing values generated)

. * --- parse coordenadas (separadores de milhar; parte inteira 2 dígitos) ---
. foreach c in latitude longitude {
  2.     gen `c'_s = subinstr(`c', ".", "", .)
  3.     gen neg = strpos(`c'_s,"-")>0
  4.     replace `c'_s = subinstr(`c'_s,"-","",.)
  5.     gen double `c'_n = real(`c'_s) / (10^(strlen(`c'_s)-2))
  6.     replace `c'_n = -`c'_n if neg==1
  7.     drop neg `c'_s
  8. }
