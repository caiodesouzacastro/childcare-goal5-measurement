  4.     replace __c = 3 if `v'>=3
  5.     tab __c
  6.     qui sum `v'
  7.     di "  media `v' = " r(mean) "   % >=1 = " %5.2f 100*(1 - (`=r(N)'>0)*0)  /* placeholder */
  8.     qui count if `v'>=1
  9.     di "  N >=1 = " r(N) "  (" %5.2f 100*r(N)/_N "%)"
 10.     drop __c
 11. end

