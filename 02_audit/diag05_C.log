. program define run1
  1.     * args: dep instr spec  ; usa global cond
.     args dep instr spec
  2.     if `spec'==1 {
  3.         qui reg `dep' `instr' estoque_1km i.ano_sol i.mes_nasc $cond
  4.     }
  5.     else {
  6.         qui areg `dep' `instr' estoque_1km i.mes_nasc $cond, absorb(setoryear)
  7.     }
  8.     qui test `instr'
  9.     di "RES| `dep' | `instr' | spec`spec' | coef=" %10.5f _b[`instr'] " se=" %9.5f _se[`instr'] ///
>        " t=" %8.2f _b[`instr']/_se[`instr'] " N=" %9.0f e(N) " r2=" %6.4f e(r2) " F=" %10.2f r(F)
 10. end

