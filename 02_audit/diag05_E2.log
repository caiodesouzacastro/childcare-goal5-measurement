  8.     tab ec if ano_nasc==`c'
  9.     qui sum expo12_1km if ano_nasc==`c'
 10.     di "  media expo12_1km = " r(mean)
 11.     qui sum ever_mat if ano_nasc==`c'
 12.     di "  taxa de matricula (ever_mat) = " r(mean)
 13.     drop ec
 14. }
