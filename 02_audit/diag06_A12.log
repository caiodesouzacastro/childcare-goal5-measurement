. * chi2 GOF vs uniforme
. qui count if inrange(mes_nasc,1,12)

. local Ntot = r(N)

. local exp = `Ntot'/12

. local chi2 = 0

. forvalues m=1/12 {
  2.     qui count if mes_nasc==`m'
  3.     local o = r(N)
  4.     local chi2 = `chi2' + (`o'-`exp')^2/`exp'
  5. }

. di "N (mes 1-12) = `Ntot' ; esperado/mes = `exp'"
N (mes 1-12) = 1524560 ; esperado/mes = 127046.6666666667

. di "Qui-quadrado(11 df) vs uniforme = " `chi2'
