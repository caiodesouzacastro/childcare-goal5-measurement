. * por crianca: tem 1o ano, tem 3o ano, primeira serie 110 ano, ever reprov
. gen byte s110 = cd_serie==110

. gen byte s112 = cd_serie==112

. gen byte rep = (sit_al_reprov==1)

. gen ano110 = an_letivo if s110==1
(7,046,620 missing values generated)

. collapse (max) tem1ano=s110 tem3ano=s112 ever_reprov=rep (min) ano_ent_1ano=ano110 ///
>          (firstnm) ano_nasc_aluno mes_nasc_aluno, by(cd_aluno_sme)

. * on-time: esperado = ano_nasc+6 se mes<=3, senao +7
. gen esperado = ano_nasc_aluno + cond(mes_nasc_aluno<=3,6,7)

. gen byte ontime = (ano_ent_1ano==esperado) if tem1ano==1
(1,603,222 missing values generated)

. save "$aud\traj_child.dta", replace
(file <NE_ROOT>\_audit\traj_child.dta not found)
file <NE_ROOT>\_audit\traj_child.dta saved

. 
. di "--- E1: por coorte, N com 1o ano e 3o ano observados ---"
--- E1: por coorte, N com 1o ano e 3o ano observados ---

. forvalues c=2008/2012 {
  2.     qui count if ano_nasc_aluno==`c'
  3.     local nt=r(N)
  4.     qui count if ano_nasc_aluno==`c' & tem1ano==1
  5.     local n1=r(N)
  6.     qui count if ano_nasc_aluno==`c' & tem3ano==1
  7.     local n3=r(N)
  8.     di "  coorte `c': N traj=`nt'  ; 1o ano=`n1'  ; 3o ano=`n3'"
  9. }
  coorte 2008: N traj=144554  ; 1o ano=57431  ; 3o ano=51665
  coorte 2009: N traj=143713  ; 1o ano=57942  ; 3o ano=50648
  coorte 2010: N traj=141281  ; 1o ano=57018  ; 3o ano=13690
  coorte 2011: N traj=143260  ; 1o ano=51634  ; 3o ano=2
  coorte 2012: N traj=144321  ; 1o ano=13413  ; 3o ano=1

. di ""


. di "--- E2: taxa on-time no 1o ano e taxa de repeticao (fundamental), por coorte ---"
--- E2: taxa on-time no 1o ano e taxa de repeticao (fundamental), por coorte ---

. forvalues c=2008/2012 {
  2.     qui sum ontime if ano_nasc_aluno==`c' & tem1ano==1
  3.     local ot=r(mean)
  4.     local n1=r(N)
  5.     qui sum ever_reprov if ano_nasc_aluno==`c'
  6.     local rr=r(mean)
  7.     di "  coorte `c': on-time(1oano)=" %5.3f `ot' " (N=`n1')  ; taxa reprov=" %5.3f `rr'
  8. }
  coorte 2008: on-time(1oano)=0.988 (N=57431)  ; taxa reprov=0.027
  coorte 2009: on-time(1oano)=0.987 (N=57942)  ; taxa reprov=0.023
  coorte 2010: on-time(1oano)=0.989 (N=57018)  ; taxa reprov=0.010
  coorte 2011: on-time(1oano)=0.994 (N=51634)  ; taxa reprov=0.002
  coorte 2012: on-time(1oano)=0.991 (N=13413)  ; taxa reprov=0.001

. di ""


. di "--- E3: N disponivel por desfecho administrativo (coortes 2008-2012) ---"
