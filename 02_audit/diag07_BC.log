. di "--- C1: P(EI antes dos 12m) marco vs abril, por coorte ---"
--- C1: P(EI antes dos 12m) marco vs abril, por coorte ---

. forvalues c=2009/2015 {
  2.     qui sum ei12 if ano_nasc==`c' & abril==0
  3.     local m3=r(mean)
  4.     qui sum ei12 if ano_nasc==`c' & abril==1
  5.     local m4=r(mean)
  6.     qui ttest ei12 if ano_nasc==`c', by(abril)
  7.     di "  coorte `c': marco=" %5.3f `m3' "  abril=" %5.3f `m4' "  dif=" %6.3f r(mu_1)-r(mu_2) "  se=" %6.4f r(se) "  p=" %6.4f r(p)
  8. }
