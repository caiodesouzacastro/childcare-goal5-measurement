. di "########## E2 — razao marco/abril de N por coorte (B_novo) ##########"
########## E2 — razao marco/abril de N por coorte (B_novo) ##########

. use "$aud\B_novo.dta", clear

. forvalues c=2009/2015 {
  2.     qui count if ano_nasc==`c' & mes_nasc==3
  3.     local n3=r(N)
  4.     qui count if ano_nasc==`c' & mes_nasc==4
  5.     local n4=r(N)
  6.     di "  coorte `c': N marco=`n3'  N abril=`n4'  razao mar/abr=" %5.3f `n3'/`n4'
  7. }
  coorte 2009: N marco=10071  N abril=9903  razao mar/abr=1.017
