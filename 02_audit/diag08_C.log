. di "########## C3 — BALANCO: caract. escola ~ chars da crianca, absorb(cell) cluster(cep) ##########"
########## C3 — BALANCO: caract. escola ~ chars da crianca, absorb(cell) cluster(cep) ##########

. foreach dep in qt_salas_existentes in_bercario qt_funcionarios dist_km conveniada {
  2.     di ""
  3.     di "==== DEP: `dep' ===="
  4.     cap reghdfe `dep' feminino branco mes_nasc idade_sol, absorb(cell) vce(cluster cep)
  5.     if !_rc {
  6.         di "  b_fem=" %8.4f _b[feminino] " (se " %7.4f _se[feminino] ")  b_branco=" %8.4f _b[branco] " (se " %7.4f _se[branco] ")"
  7.         di "  b_mesnasc=" %8.4f _b[mes_nasc] " (se " %7.4f _se[mes_nasc] ")  b_idadesol=" %8.4f _b[idade_sol] " (se " %7.4f _se[idade_sol] ")"
  8.         test feminino branco mes_nasc idade_sol
  9.         di "  >>> F conjunto = " %8.3f r(F) "  p = " %6.4f r(p) "  N=" e(N)
 10.     }
 11.     else di "  ERRO rc=`=_rc'"
 12. }

