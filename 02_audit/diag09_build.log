. * programa de harmonizacao: cria `tgt' a partir do 1o candidato existente
. capture program drop pick

. program define pick
  1.     args tgt
  2.     gettoken tgt cands : 0
  3.     cap confirm variable `tgt'
  4.     if !_rc exit
  5.     gen `tgt' = .
  6.     foreach c of local cands {
  7.         cap confirm variable `c'
  8.         if !_rc {
  9.             cap replace `tgt' = `c'
 10.             if _rc {
 11.                 cap destring `c', gen(_tmp) force dpcomma
 12.                 cap replace `tgt' = _tmp
 13.                 cap drop _tmp
 14.             }
 15.             continue, break
 16.         }
 17.     }
 18. end

. 
. tempfile acc

. clear

. gen byte _x=.

. save `acc', emptyok
(dataset contains 0 observations)
file <HOME>\AppData\Local\Temp\ST_f94_000001.tmp saved as .dta format

. 
. foreach spec in "cpf_fila_07 2007" "cpf_fila_081 2008" "cpf_fila_092 2009" "cpf_fila_101 2010" "cpf_fila_102 2010" "cpf_fila_11 2011" "cpf_fila_12 2012" "cpf_fila_13 2013" "cpf_fila_14 2014" {
  2.     gettoken f yr : spec
  3.     use "$rc/`f'.dta", clear
  4.     * harmonizar (nomes numericos)
.     gen byte emp_raw = .
  5.     cap replace emp_raw = empem3112
  6.     cap replace emp_raw = vínculoativo3112
  7.     gen byte sex_raw = .
  8.     cap replace sex_raw = genero
  9.     cap replace sex_raw = sexotrabalhador
 10.     gen byte estabsz = .
 11.     cap replace estabsz = tamestab
 12.     cap replace estabsz = tamanhoestabelecimento
 13.     gen double njur = .
 14.     cap replace njur = naturjur
 15.     cap replace njur = natjuridica
 16.     cap replace njur = naturezajurídica
 17.     * strings -> destring
.     gen double wnom = .
 18.     cap destring remmedia, gen(_w1) force dpcomma
 19.     cap replace wnom = _w1
 20.     cap destring vlremunmédianom, gen(_w2) force dpcomma
 21.     cap replace wnom = _w2
 22.     cap drop _w1 _w2
 23.     gen double hrs = .
 24.     cap destring horascontr, gen(_h1) force dpcomma
 25.     cap replace hrs = _h1
 26.     cap confirm variable qtdhoracontr
 27.     if !_rc cap replace hrs = qtdhoracontr
 28.     cap drop _h1
 29.     * nascimento da mae
.     gen int maeb = .
 30.     cap replace maeb = `yr' - idade
 31.     cap replace maeb = floor(dtnasciment/10000) if missing(maeb) & dtnasciment>19000000 & dtnasciment<20200000
 32.     gen int rais_year = `yr'
 33.     keep cd_aluno_sme cpf emp_raw sex_raw estabsz njur wnom hrs maeb rais_year ano_nasc mes_nasc
 34.     append using `acc'
 35.     save `acc', replace
 36.     di "  `f' (`yr') carregado"
 37. }
