. di "########## Painel corrigido (fem via string; salario em SM direto) ##########"
########## Painel corrigido (fem via string; salario em SM direto) ##########

. tempfile acc

. clear

. gen byte _x=.

. save `acc', emptyok
(dataset contains 0 observations)
file <HOME>\AppData\Local\Temp\ST_1d28_000001.tmp saved as .dta format

. foreach spec in "cpf_fila_07 2007" "cpf_fila_081 2008" "cpf_fila_092 2009" "cpf_fila_101 2010" "cpf_fila_102 2010" "cpf_fila_11 2011" "cpf_fila_12 2012" "cpf_fila_13 2013" "cpf_fila_14 2014" {
  2.     gettoken f yr : spec
  3.     use "$rc/`f'.dta", clear
  4.     gen byte emp_raw = .
  5.     cap replace emp_raw = empem3112
  6.     cap replace emp_raw = vínculoativo3112
  7.     * sexo
.     gen byte fem = .
  8.     cap replace fem = (genero=="FEMININO")
  9.     cap replace fem = (sexotrabalhador==2)
 10.     * salario em SM (direto)
.     gen double wsm = .
 11.     cap destring remmedia, gen(_r) force dpcomma
 12.     cap replace wsm = _r
 13.     cap drop _r
 14.     cap destring vlremunmédiasm, gen(_s) force dpcomma
 15.     cap replace wsm = _s
 16.     cap drop _s
 17.     * horas
.     gen double hrs = .
 18.     cap destring horascontr, gen(_h) force dpcomma
 19.     cap replace hrs = _h
 20.     cap drop _h
 21.     cap replace hrs = qtdhoracontr
 22.     * estab e natjur
.     gen double estabsz = .
 23.     cap replace estabsz = tamestab
 24.     cap replace estabsz = tamanhoestabelecimento
 25.     gen double njur = .
 26.     cap replace njur = naturjur
 27.     cap replace njur = natjuridica
 28.     cap replace njur = naturezajurídica
 29.     * nasc mae
.     gen int maeb = .
 30.     cap replace maeb = `yr' - idade
 31.     cap replace maeb = floor(dtnasciment/10000) if missing(maeb) & dtnasciment>19000000 & dtnasciment<20200000
 32.     gen int rais_year = `yr'
 33.     keep cd_aluno_sme cpf emp_raw fem wsm hrs estabsz njur maeb rais_year ano_nasc mes_nasc
 34.     append using `acc'
 35.     save `acc', replace
 36. }
