. di "########## A1 — empem3112: quantos arquivos so tem empregados (rate=1)? ##########"
########## A1 — empem3112: quantos arquivos so tem empregados (rate=1)? ##########

. foreach spec in "cpf_fila_07 2007" "cpf_fila_081 2008" "cpf_fila_092 2009" "cpf_fila_101 2010" "cpf_fila_102 2010" "cpf_fila_11 2011" "cpf_fila_12 2012" "cpf_fila_13 2013" "cpf_fila_14 2014" {
  2.     gettoken f yr : spec
  3.     use "$rc/`f'.dta" in 1/1, clear
  4.     * so contar a media de empem3112/vinc na base inteira
.     cap use empem3112 using "$rc/`f'.dta", clear
  5.     if !_rc {
  6.         qui sum empem3112
  7.         di "  `f' (`yr'): empem3112 media=" %5.3f r(mean) "  N=" r(N) "  (1.000 => so empregados)"
  8.     }
  9.     else {
 10.         use vínculoativo3112 using "$rc/`f'.dta", clear
 11.         qui sum vínculoativo3112
 12.         di "  `f' (`yr'): vinc media=" %5.3f r(mean) "  N=" r(N)
 13.     }
 14. }
